{
  "expo": {
    "name": "Adhivakta",
    "slug": "Adhivakta-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "adhivakta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auxgens.adhivakta"
    },

    "android": {
      "package": "com.adhivakta.app",
      "googleServicesFile": "./google-services.json"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },

    "plugins": ["expo-router"]
  }
}